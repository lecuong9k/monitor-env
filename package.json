{
  "name": "monitor-env",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/lecuong9k/monitor-env#readme",
  "bugs": {
    "url": "https://github.com/lecuong9k/monitor-env/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lecuong9k/monitor-env.git"
  },
  "license": "ISC",
  "author": "lecuong",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "NODE_ENV=production node --import ./src/load-env.js src/app.js",
    "dev": "NODE_ENV=development node --import ./src/load-env.js --watch src/app.js",
    "camera-service": "NODE_ENV=production node --import ./src/load-env.js src/camera-service/app.js",
    "camera-service:dev": "sh scripts/camera-service-stop.sh && sleep 1 && NODE_ENV=development node --import ./src/load-env.js --watch src/camera-service/app.js",
    "camera-service:stop": "sh scripts/camera-service-stop.sh",
    "secrets:key": "node -e \"import('./src/utils/secrets.js').then(m=>console.log(m.generateSecretsKey()))\"",
    "job:modbus": "NODE_ENV=production node --import ./src/load-env.js src/jobs/modbus.js",
    "copy-fe": "rm -rf dist && cp -R ../monitor-env-fe/dist dist",
    "mediamtx": "sh scripts/mediamtx-stop.sh && sleep 1 && ./mediamtx mediamtx.development.yml",
    "mediamtx:prod": "sh scripts/mediamtx-stop.sh && sleep 1 && ./mediamtx mediamtx.production.yml",
    "mediamtx:stop": "sh scripts/mediamtx-stop.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs --lines 100",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ffmpeg-static": "5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "modbus-serial": "^8.0.25",
    "onvif": "^0.8.1",
    "serialport": "^13.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "fastify-tsconfig": "^3.0.0",
    "typescript": "^6.0.3"
  }
}
