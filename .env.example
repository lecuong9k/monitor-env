# Môi trường: production bật CSP của helmet
NODE_ENV=development

# Cổng / host server
PORT=3000
HOST=0.0.0.0

# CORS — danh sách origin cách nhau bởi dấu phẩy (hoặc * cho mọi origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit toàn cục
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Giới hạn body JSON (bytes)
BODY_LIMIT_BYTES=65536

# Timeout mỗi request (ms)
REQUEST_TIMEOUT_MS=30000

# Đặt true nếu chạy sau reverse proxy (nginx)
TRUST_PROXY=false
