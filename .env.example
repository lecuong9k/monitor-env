# =============================================================================
# monitor-env-be (MiniPC) — mẫu biến môi trường
# Dev: .env.development | Prod: .env.production | Ghi đè: .env.local
# =============================================================================

NODE_ENV=development

# --- HTTP (monitor-env app :3000) ---
PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (:4001) ---
CAMERA_SERVICE_URL=http://127.0.0.1:4001
# CAMERA_SERVICE_PORT=4001
# CAMERA_SERVICE_HOST=127.0.0.1
CAMERA_SECRETS_KEY=change-me-64-hex-chars
CAMERA_SERVICE_API_KEY=change-me-64-hex-chars

# --- Stream ---
STREAM_MODE=webrtc
# Local ingest: mediamtx (Camera RTSP → MTX local) | ffmpeg (legacy transcode)
STREAM_LOCAL_INGEST_MODE=mediamtx
STREAM_IDLE_STOP_MS=120000
STREAM_IDLE_POLL_MS=15000
# TTL viewer không heartbeat → gỡ khỏi session (ms). Client gửi heartbeat ~30s.
STREAM_VIEWER_HEARTBEAT_TTL_MS=45000
CENTRAL_RELAY_IDLE_STOP_MS=60000
# Viewer còn trong Map nhưng MTX reader=0 liên tục → coi ghost (ms).
STREAM_READER_GHOST_MS=30000
# Mỗi N chu kỳ poll sweep path MTX không quản lý (0 = tắt).
STREAM_MTX_SWEEP_EVERY_POLLS=4
STREAM_HEARTBEAT_MAX_ITEMS=32
# FFMPEG_PATH=/usr/bin/ffmpeg
# Dev: libx264 | Prod Pi: h264_v4l2m2m
# FFMPEG_VIDEO_ENCODER=libx264
# FFMPEG_VIDEO_ENCODER_FALLBACK=libx264
# HLS_OUTPUT_DIR=./streams

# --- MediaMTX local (chạy trên MiniPC — PM2 mediamtx / npm run mediamtx:prod) ---
MEDIAMTX_LOCAL_API_URL=http://127.0.0.1:9997
MEDIAMTX_LOCAL_RTSP_URL=rtsp://127.0.0.1:8554
# WHEP cho MiniPC UI — tự detect IP LAN nếu không set
MEDIAMTX_LOCAL_WEBRTC_URL=http://127.0.0.1:8889
# MEDIAMTX_LOCAL_LAN_IP=192.168.x.x
# MEDIAMTX_LOCAL_WEBRTC_PORT=8889
# MEDIAMTX_LOCAL_WEBRTC_PROTOCOL=http
# origin=http://lan-ip:3000 → ghi đè WHEP base theo origin FE
# MEDIAMTX_LOCAL_WEBRTC_ORIGIN_MAP=http://192.168.x.x:3000=http://192.168.x.x:8889

# --- MediaMTX central (server Mbox — remote viewer / Mbox UI) ---
MEDIAMTX_CENTRAL_API_URL=http://mbox-ip:9997
MEDIAMTX_CENTRAL_WEBRTC_URL=http://mbox-ip:8889
MEDIAMTX_CENTRAL_RTSP_PUBLISH_URL=rtsp://mbox-ip:8554
# origin FE → WHEP host khác (CDN, tunnel…)
# MEDIAMTX_CENTRAL_WEBRTC_ORIGIN_MAP=http://mbox-ip:20001=http://mbox-ip:8889

# Legacy (fallback nếu chưa đổi sang MEDIAMTX_CENTRAL_*)
# MEDIAMTX_API_URL=http://mbox-ip:9997
# MEDIAMTX_WEBRTC_URL=http://mbox-ip:8889
# MEDIAMTX_RTSP_PUBLISH_URL=rtsp://mbox-ip:8554
# MEDIAMTX_WEBRTC_ORIGIN_MAP=

# MEDIAMTX_HEALTH_CACHE_MS=10000

# --- Edge agent (kết nối outbound WebSocket lên Mbox) ---
MBOX_EDGE_WS_URL=ws://mbox-ip:20001/edge/ws
# machineCode tự sinh trên MiniPC (SQLite) — xem UI Cấu hình chung / GET /device-identity
EDGE_AGENT_TOKEN=change-me-edge-token
# EDGE_STATUS_REPORT_MS=30000
# EDGE_RECONNECT_MIN_MS=5000
# EDGE_RECONNECT_MAX_MS=60000

# --- Modbus → Mbox temperature ingest (bỏ trống = không gửi) ---
# MBOX_TEMP_INGEST_URL=http://mbox-ip:20003
# DEVICE_MODEL=MINI PC 001
