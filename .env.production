# Production — nạp khi NODE_ENV=production
# Ghi đè bí mật trên server: .env.local (không commit)

NODE_ENV=production

PORT=3000

STATIC_DIR=dist

# Origin truy cập web app
CORS_ORIGINS=http://192.168.5.97:3000,http://45.76.152.73:20001

RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- Camera ONVIF / RTSP ---
CAMERA_HOST=192.168.5.61
CAMERA_PORT=80
CAMERA_USERNAME=admin
CAMERA_PASSWORD=123456aA@

# Ưu tiên dùng URL encode đầy đủ nếu camera khó kết nối ONVIF
# CAMERA_RTSP_URL=rtsp://admin:123456aA%40@192.168.5.61:554/rtsp/streaming?channel=01&subtype=0

CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH_MAIN=/rtsp/streaming?channel=01&subtype=0
CAMERA_RTSP_PATH_SUB=/rtsp/streaming?channel=01&subtype=1
CAMERA_RTSP_PATH_MOBILE=/rtsp/streaming?channel=01&subtype=2

STREAM_MODE=webrtc
STREAM_QUALITY=main

# MediaMTX cùng máy (PM2)
MEDIAMTX_API_URL=http://127.0.0.1:9997
# URL browser dùng để đọc WHEP; phải khớp webrtcAdditionalHosts
MEDIAMTX_WEBRTC_URL=http://192.168.5.97:8889
# Nếu user vào bằng IP public:
# MEDIAMTX_WEBRTC_URL=http://45.76.152.73:8889
MEDIAMTX_PATH=camera1

HLS_OUTPUT_DIR=./streams
HOME_PRESET_TOKEN=255
