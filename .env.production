# Production — MiniPC (monitor-env-be)
# Ghi đè secret: .env.local (không commit)
# MediaMTX chạy trên server Mbox — KHÔNG chạy mediamtx trên MiniPC

NODE_ENV=production

# --- monitor-env (app :3000, tùy chọn UI local) ---
PORT=3000
STATIC_DIR=dist
# IP LAN (vd. 192.168.x.x) được tự cho phép trong security.js
CORS_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (localhost:4001) ---
STREAM_MODE=webrtc
# Multi-path stream: dừng upstream quality path khi không còn WHEP reader (ms). 0 = tắt auto-stop
STREAM_IDLE_STOP_MS=300000
# Poll MediaMTX reader count (ms)
STREAM_IDLE_POLL_MS=60000
CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Sinh: npm run secrets:key / openssl rand -hex 32
CAMERA_SECRETS_KEY=70b6b622b52d88739430057fd8d7bc740d08420ad7b16af798126960dc00d54e
CAMERA_SERVICE_API_KEY=8e45c979a90aa4d671f866bca156a8d805491037a8be5569f5b2e9979434cde8

# --- MediaMTX trung tâm (server Mbox) ---
MEDIAMTX_API_URL=http://45.76.152.73:9997
MEDIAMTX_WEBRTC_URL=http://45.76.152.73:8889
# MiniPC FFmpeg push RTSP lên VPS (mặc định suy ra từ hostname API + :8554)
MEDIAMTX_RTSP_PUBLISH_URL=rtsp://45.76.152.73:8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_PROTOCOL=http
# Backup local khi MediaMTX sập (UI localhost/LAN → relay MPEG-TS qua FFmpeg)
MEDIAMTX_LOCAL_FALLBACK=true
# MEDIAMTX_HEALTH_CACHE_MS=10000
# ws fallback URL: tự detect IP LAN MiniPC (không cần set). Override tùy chọn:
# PUBLIC_WS_BASE_URL=http://192.168.x.x:3000
# PUBLIC_WS_ORIGIN_MAP=http://192.168.5.97:20001=http://192.168.5.100:3000

# --- Edge agent (kết nối outbound WebSocket lên Mbox) ---
MBOX_EDGE_WS_URL=ws://45.76.152.73:20001/edge/ws
EDGE_ID=8e3f7cacf1c6ff30600730d44370f16b9b148fd6b1d2eb9cbf3348fb26e62c70
EDGE_AGENT_TOKEN=e704b5a854d349fc937a1834b4f3278b7242a1e95ac52cb49b0b77562c3c0517

# EDGE_STATUS_REPORT_MS=30000
# EDGE_RECONNECT_MIN_MS=5000
# EDGE_RECONNECT_MAX_MS=60000
