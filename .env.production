# Production — nạp khi NODE_ENV=production
# Ghi đè bí mật trên server: .env.local (không commit)

NODE_ENV=production

# --- monitor-env (app chính :3000) ---
PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://192.168.5.97:3000,http://45.76.152.73:20001
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (stream, PTZ, DB camera) ---
STREAM_MODE=webrtc
MEDIAMTX_API_URL=http://127.0.0.1:9997
# URL browser dùng WHEP — khớp webrtcAdditionalHosts trong mediamtx.production.yml
MEDIAMTX_WEBRTC_URL=http://192.168.5.97:8889
# Nếu user vào bằng IP public:
# MEDIAMTX_WEBRTC_URL=http://45.76.152.73:8889
HLS_OUTPUT_DIR=./streams

CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Bắt buộc — đặt trong .env.local: npm run secrets:key + openssl rand -hex 32
CAMERA_SECRETS_KEY=440ca02d60ea1e741720d4a786d66f769b9a79f655336188ca516c411bd9e7f5
CAMERA_SERVICE_API_KEY=cfbea9068cc88130a8284979888904540825b8205c7492455058d59ccf627c66

# Camera: thêm/sửa tại #/cau-hinh/camera (lưu data/camera.db)
