# Production — MiniPC (monitor-env-be)
# Ghi đè secret: .env.local (không commit)

NODE_ENV=production

PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

STREAM_MODE=webrtc
STREAM_IDLE_STOP_MS=300000
STREAM_IDLE_POLL_MS=60000
CENTRAL_RELAY_IDLE_STOP_MS=120000
