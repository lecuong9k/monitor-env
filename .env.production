# Production — MiniPC (monitor-env-be)
# Ghi đè secret: .env.local (không commit)
# MediaMTX chạy trên server Mbox — KHÔNG chạy mediamtx trên MiniPC

NODE_ENV=production

# --- monitor-env (app :3000, tùy chọn UI local) ---
PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (localhost:4001) ---
STREAM_MODE=webrtc
CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Sinh: npm run secrets:key / openssl rand -hex 32
CAMERA_SECRETS_KEY=change-me-64-hex-chars
CAMERA_SERVICE_API_KEY=change-me-camera-service-api-key

# --- MediaMTX trung tâm (server Mbox) ---
MEDIAMTX_API_URL=http://45.76.152.73:9997
MEDIAMTX_WEBRTC_URL=http://45.76.152.73:8889
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_PROTOCOL=http

# --- Edge agent (kết nối outbound WebSocket lên Mbox) ---
MBOX_EDGE_WS_URL=ws://45.76.152.73:20001/edge/ws
EDGE_ID=site-a-001
EDGE_AGENT_TOKEN=e704b5a854d349fc937a1834b4f3278b7242a1e95ac52cb49b0b77562c3c0517

# EDGE_STATUS_REPORT_MS=30000
# EDGE_RECONNECT_MIN_MS=5000
# EDGE_RECONNECT_MAX_MS=60000
