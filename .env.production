# Production — nạp khi NODE_ENV=production
# Ghi đè bí mật trên server: .env.local (không commit)

NODE_ENV=production

# --- monitor-env (app chính :3000) ---
PORT=3000
STATIC_DIR=dist
# Thêm origin FE thực tế (IP/domain + port). Không cần hardcode IP WHEP ở đây.
CORS_ORIGINS=http://192.168.5.97:3000,http://45.76.152.73:20001
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
# Bật true nếu chạy sau reverse proxy (nginx) để đọc X-Forwarded-Host
TRUST_PROXY=false

# --- camera-service (stream, PTZ, DB camera) ---
STREAM_MODE=webrtc
MEDIAMTX_API_URL=http://127.0.0.1:9997
# WHEP URL động: user vào http://<host>:3000 -> WHEP http://<host>:8889
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_PROTOCOL=http
# Fallback khi không có Origin/Host
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
# Tuỳ chọn: map origin FE -> URL WHEP (khi WHEP host khác hostname FE)
# MEDIAMTX_WEBRTC_ORIGIN_MAP=https://app.example.com=https://media.example.com:8889
HLS_OUTPUT_DIR=./streams

CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Bắt buộc — đặt trong .env.local: npm run secrets:key + openssl rand -hex 32
CAMERA_SECRETS_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
CAMERA_SERVICE_API_KEY=cfbea9068cc88130a8284979888904540825b8205c7492455058d59ccf627c66

# Camera: thêm/sửa tại #/cau-hinh/camera (lưu data/camera.db)

# --- Edge agent (kết nối outbound lên Mbox) ---
# Đặt EDGE_ID unique cho mỗi MiniPC; token trùng EDGE_AGENT_TOKEN trên Mbox
# MBOX_EDGE_WS_URL=ws://45.76.152.73:20001/edge/ws
# EDGE_ID=site-a-001
# EDGE_AGENT_TOKEN=change-me-edge-token
