# Development — nạp khi NODE_ENV=development (npm run dev)
# Ghi đè bí mật cục bộ: .env.local (không commit)

NODE_ENV=development

# --- monitor-env (app chính :3000) ---
PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (stream, PTZ, DB camera) ---
STREAM_MODE=webrtc
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
HLS_OUTPUT_DIR=./streams

CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Sinh key: npm run secrets:key
CAMERA_SECRETS_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
CAMERA_SERVICE_API_KEY=d1204b378d2670f2c9ae7214c08d5bdd9b2386745580561fb2bd14e90612e245

# Camera: thêm/sửa tại #/cau-hinh/camera (lưu data/camera.db)
