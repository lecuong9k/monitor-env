# Development — nạp khi NODE_ENV=development (npm run dev)
# Ghi đè bí mật cục bộ: .env.local (không commit)

NODE_ENV=development

# --- monitor-env (app chính :3000) ---
PORT=3000
STATIC_DIR=dist
# Thêm origin FE khi test (LAN/public). Có thể dùng * trong dev nếu cần.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (stream, PTZ, DB camera) ---
STREAM_MODE=webrtc
MEDIAMTX_API_URL=http://127.0.0.1:9997
# WHEP URL động: hostname = Origin/Host của browser, port = MEDIAMTX_WEBRTC_PORT
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_PROTOCOL=http
# Chỉ dùng khi request không có Origin/Host (fallback nội bộ)
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
# Tuỳ chọn: map origin FE -> URL WHEP cố định (CDN, tunnel, localhost -> 127.0.0.1)
# MEDIAMTX_WEBRTC_ORIGIN_MAP=http://localhost:5173=http://127.0.0.1:8889
HLS_OUTPUT_DIR=./streams

CAMERA_SERVICE_URL=http://127.0.0.1:4001
# Sinh key: npm run secrets:key
CAMERA_SECRETS_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
CAMERA_SERVICE_API_KEY=cfbea9068cc88130a8284979888904540825b8205c7492455058d59ccf627c66

# Camera: thêm/sửa tại #/cau-hinh/camera (lưu data/camera.db)

# --- Edge agent (kết nối outbound lên Mbox) ---
# MBOX_EDGE_WS_URL=ws://localhost:20001/edge/ws
# EDGE_ID=site-dev-001
# EDGE_AGENT_TOKEN=change-me-edge-token
