# Development — nạp khi NODE_ENV=development (npm run dev)
# Ghi đè secret: .env.local (không commit)

NODE_ENV=development

# --- monitor-env (app :3000) ---
PORT=3000
STATIC_DIR=dist
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- camera-service (localhost:4001) ---
CAMERA_SERVICE_URL=http://127.0.0.1:4001
# CAMERA_SERVICE_PORT=4001
# CAMERA_SERVICE_HOST=127.0.0.1
CAMERA_SECRETS_KEY=70b6b622b52d88739430057fd8d7bc740d08420ad7b16af798126960dc00d54e
CAMERA_SERVICE_API_KEY=8e45c979a90aa4d671f866bca156a8d805491037a8be5569f5b2e9979434cde8

# --- Stream (hybrid: local MTX ingest + central relay khi scope=remote) ---
STREAM_MODE=webrtc
# Local: mediamtx = Camera RTSP → MTX local | ffmpeg = legacy transcode/copy
STREAM_LOCAL_INGEST_MODE=mediamtx
STREAM_IDLE_STOP_MS=120000
STREAM_IDLE_POLL_MS=15000
# TTL viewer không heartbeat → gỡ khỏi session (ms). Client gửi heartbeat ~30s.
STREAM_VIEWER_HEARTBEAT_TTL_MS=45000
CENTRAL_RELAY_IDLE_STOP_MS=60000
STREAM_READER_GHOST_MS=30000
STREAM_MTX_SWEEP_EVERY_POLLS=4
# WS batch heartbeat viewer (MiniPC UI): auto | ws | http
STREAM_HEARTBEAT_TRANSPORT=auto
STREAM_HEARTBEAT_ACK_TIMEOUT_MS=10000
STREAM_HEARTBEAT_MAX_ITEMS=32
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFMPEG_VIDEO_ENCODER=libx264
# FFMPEG_VIDEO_ENCODER_FALLBACK=libx264

# --- MediaMTX local — npm run mediamtx:dev (mediamtx.dev.yml) ---
# Port tách khỏi Mbox central (:9997/:8889/:8554) — xem bảng trong mediamtx.dev.yml
MEDIAMTX_LOCAL_API_URL=http://127.0.0.1:9996
MEDIAMTX_LOCAL_RTSP_URL=rtsp://127.0.0.1:8555
MEDIAMTX_LOCAL_WEBRTC_URL=http://127.0.0.1:8890
# MEDIAMTX_LOCAL_LAN_IP=192.168.x.x
# MEDIAMTX_LOCAL_WEBRTC_PORT=8890
# MEDIAMTX_LOCAL_WEBRTC_PROTOCOL=http
MEDIAMTX_LOCAL_WEBRTC_ORIGIN_MAP=http://127.0.0.1:3000=http://127.0.0.1:8890,http://localhost:3000=http://127.0.0.1:8890,http://localhost:5173=http://127.0.0.1:8890

# --- MediaMTX central — Mbox npm run mediamtx:dev (mediamtx.development.yml) ---
MEDIAMTX_CENTRAL_API_URL=http://127.0.0.1:9997
MEDIAMTX_CENTRAL_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_CENTRAL_RTSP_PUBLISH_URL=rtsp://127.0.0.1:8554
# Mbox đăng ký path central — MiniPC chỉ relay RTSP (deploy đồng bộ với Mbox)
CENTRAL_PATH_REGISTERED_BY_MBOX=true
MEDIAMTX_CENTRAL_WEBRTC_ORIGIN_MAP=http://localhost:20001=http://127.0.0.1:8889,http://127.0.0.1:20001=http://127.0.0.1:8889

# Legacy fallback (tương thích code cũ — ưu tiên MEDIAMTX_CENTRAL_*)
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
# MEDIAMTX_RTSP_PUBLISH_URL=rtsp://127.0.0.1:8554

MEDIAMTX_HEALTH_CACHE_MS=10000

# --- Edge agent (kết nối outbound WebSocket lên Mbox) ---
MBOX_EDGE_WS_URL=ws://localhost:20001/edge/ws
DEVICE_ID=8e3f7cacf1c6ff30600730d44370f16b9b148fd6b1d2eb9cbf3348fb26e62c70
EDGE_AGENT_TOKEN=565ce22b85785fdf07ffaaa0f84d2d28098c7bf44318b6e7ff38d0419b20ffaf
# AI_AGENT_TOKEN được cấu hình bên dưới và phải trùng với Mbox

EDGE_STATUS_REPORT_MS=30000
EDGE_RECONNECT_MIN_MS=5000
EDGE_RECONNECT_MAX_MS=60000
# AI_AGENT_TOKEN là shared secret dùng chung để xác thực AI Agent tại Mbox và MiniPC; các phía phải cùng giá trị; không nhầm với EDGE_AGENT_TOKEN hay DOCK_OPS_API_KEY.
AI_AGENT_TOKEN=dev-ai-agent-token-change-me
