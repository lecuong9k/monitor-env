# Development — nạp khi NODE_ENV=development (npm run dev)
# Ghi đè bí mật cục bộ: .env.local (không commit)

NODE_ENV=development

PORT=3000

STATIC_DIR=dist

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY=false

# --- Camera ONVIF / RTSP ---
CAMERA_HOST=192.168.5.61
CAMERA_PORT=80
CAMERA_USERNAME=admin
CAMERA_PASSWORD=123456aA@

# RTSP URL tùy chỉnh (encode ký tự đặc biệt trong mật khẩu)
# CAMERA_RTSP_URL=rtsp://admin:123456aA%40@192.168.5.61:554/rtsp/streaming?channel=01&subtype=0

CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH_MAIN=/rtsp/streaming?channel=01&subtype=0
CAMERA_RTSP_PATH_SUB=/rtsp/streaming?channel=01&subtype=1
CAMERA_RTSP_PATH_MOBILE=/rtsp/streaming?channel=01&subtype=2

STREAM_MODE=webrtc
STREAM_QUALITY=main

# MediaMTX local — chạy: npm run mediamtx
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_PATH=camera1

HLS_OUTPUT_DIR=./streams
HOME_PRESET_TOKEN=255
